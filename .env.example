# ============================================================
# GoldXBot - Safe Local Configuration Template
# ============================================================
#
# Copy this file to .env only when local configuration is needed:
#
#   Copy-Item .env.example .env
#
# Never commit the real .env file.
#

# Application
APP_NAME=GoldX Enterprise Bot
APP_ENV=development

# Execution mode: BACKTEST, PAPER, DEMO, or LIVE
# PAPER is the safe default and must not submit broker orders.
BOT_MODE=PAPER

# Keep disabled during development, backtesting, paper, and demo work.
ENABLE_LIVE_TRADING=false

# Deliberately blank.
# Live activation will be handled in a later controlled deployment phase.
LIVE_TRADING_CONFIRMATION=

# Optional absolute path to terminal64.exe.
# Leave blank to use the terminal detected by MetaTrader5.
MT5_TERMINAL_PATH=

# Broker-specific Gold symbol candidates, checked in listed order.
GOLD_SYMBOL_CANDIDATES=XAUUSD,XAUUSDm,XAUUSD.,GOLD,Gold

# Market data
TIMEFRAME=M15
CANDLES_COUNT=500

# Risk controls
RISK_PER_TRADE_PERCENT=0.25
MAX_RISK_PER_TRADE_PERCENT=1.00
MAX_DAILY_LOSS_PERCENT=2.00
MAX_TRADES_PER_DAY=3
MAX_OPEN_TRADES=1

# Order identity
MAGIC_NUMBER=26062801
ORDER_COMMENT=goldx_enterprise_bot

# Broker safety
MAX_SPREAD_POINTS=50

# Logging
LOG_LEVEL=INFO
LOG_DIR=data/logs